@inherits LayoutComponentBase
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <AuthorizeView>
                <Authorized>
                    <span class="user-name">@GetUserDisplayName(context.User)</span>
                    <a href="/MicrosoftIdentity/Account/SignOut">退出登录</a>
                </Authorized>
                <NotAuthorized>
                    <span class="user-name">访客</span>
                    <a href="/MicrosoftIdentity/Account/SignIn">登录</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    private static string GetUserDisplayName(ClaimsPrincipal user)
    {
        var fullName = user.FindFirst("name")?.Value
            ?? user.FindFirst("given_name")?.Value
            ?? user.Identity?.Name
            ?? "用户";

        if (!string.IsNullOrWhiteSpace(fullName))
        {
            return fullName;
        }

        return "用户";
    }
}

<div id="blazor-error-ui" data-nosnippet>
    发生了未处理的错误。
    <a href="." class="reload">重新加载</a>
    <span class="dismiss" aria-label="关闭">🗙</span>
</div>
