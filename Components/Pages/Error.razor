@page "/Error"
@using System.Diagnostics

<PageTitle>发生错误</PageTitle>

<section class="error-page">
    <span class="error-code">500</span>
    <h1>发生错误</h1>
    <h2>处理请求时出现问题。</h2>

    @if (ShowRequestId)
    {
        <p>
            <strong>请求编号：</strong> <code>@RequestId</code>
        </p>
    }

    <h3>开发模式</h3>
    <p>
        切换到 <strong>Development（开发）</strong>环境可以显示有关错误的更多信息。
    </p>
    <p>
        <strong>请勿在已部署的应用中启用开发环境。</strong>
        这可能会向最终用户暴露异常中的敏感信息。
        如需在本地调试，请将环境变量 <strong>ASPNETCORE_ENVIRONMENT</strong> 设置为 <strong>Development</strong>，然后重新启动应用。
    </p>
</section>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
