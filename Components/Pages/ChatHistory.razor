@page "/chathistory"
@rendermode InteractiveServer
@using BlazorWebCreateAgent.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject UserStateService UserStateService
@inject ILogger<ChatHistory> Logger

<PageTitle>对话历史</PageTitle>

<h1>对话历史</h1>

@if (!isLoaded)
{
    <p>正在加载对话历史...</p>
}
else if (!isAuthenticated)
{
    <p>请先登录以查看对话历史。</p>
}
else if (sessions.Count == 0)
{
    <p>暂未找到已保存的对话。</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th scope="col">首条消息</th>
                    <th scope="col">日期和时间</th>
                    <th scope="col">操作</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var session in sessions)
                {
                    var firstUserMessage = session.Messages.FirstOrDefault(message =>
                        string.Equals(message.Role, "user", StringComparison.OrdinalIgnoreCase));
                    <tr>
                        <td>@(firstUserMessage?.Content ?? "对话")</td>
                        <td>@session.UpdatedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            <button class="btn btn-sm btn-primary" type="button" @onclick="() => LoadSession(session.SessionId)">
                                打开
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private readonly List<ChatHistorySession> sessions = new();
    private bool isLoaded;
    private bool isAuthenticated;

    private void LoadSession(string sessionId)
    {
        Navigation.NavigateTo(Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString(
            "/chat",
            "sessionid",
            sessionId));
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        isAuthenticated = authState.User.Identity?.IsAuthenticated == true;
        if (!isAuthenticated)
        {
            isLoaded = true;
            return;
        }

        var userId = authState.User.FindFirst("oid")?.Value
            ?? authState.User.FindFirst("sub")?.Value
            ?? authState.User.Identity?.Name;

        if (string.IsNullOrWhiteSpace(userId))
        {
            isLoaded = true;
            return;
        }

        try
        {
            sessions.AddRange(await UserStateService.LoadAllChatHistoryAsync(userId));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to load chat history for user {UserId}.", userId);
        }

        isLoaded = true;
    }
}