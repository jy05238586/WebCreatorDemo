@page "/chat"
@rendermode InteractiveServer
@implements IDisposable
@using BlazorWebCreateAgent.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.AI
@inject WebCreateChatHandler ChatAgentHandler
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS
@inject UserStateService UserStateService
@inject ILogger<Home> Logger

<PageTitle>网页创作工作台</PageTitle>

<style>
    .home-page {
        --dashboard-bg: #f7f7f6;
        --dashboard-panel: #ffffff;
        --dashboard-border: #e7e6e4;
        --dashboard-ink: #242326;
        --dashboard-muted: #77767b;
        --dashboard-accent: #7356d8;
        display: grid;
        grid-template-columns: minmax(320px, 0.88fr) minmax(0, 1.45fr);
        gap: 1.1rem;
        box-sizing: border-box;
        min-height: calc(100vh - 8.5rem);
        padding: 1.5rem;
        color: var(--dashboard-ink);
        background: var(--dashboard-bg);
    }

    .chat-panel,
    .preview-panel {
        display: flex;
        flex-direction: column;
        min-width: 0;
        background: var(--dashboard-panel);
        border: 1px solid var(--dashboard-border);
        border-radius: 1.2rem;
        box-shadow: 0 4px 18px rgba(31, 29, 35, 0.035);
    }

    .panel-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        padding: 1.1rem 1.25rem;
        border-bottom: 1px solid #efeeed;
    }

    .panel-actions {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    .eyebrow {
        margin: 0 0 0.25rem;
        font-size: 0.72rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--dashboard-muted);
    }

    h2 {
        margin: 0;
        font-size: 1.4rem;
        color: var(--dashboard-ink);
        font-weight: 650;
        letter-spacing: -0.035em;
    }

    .ghost-button,
    .composer button {
        border: 1px solid #e8e7e5;
        border-radius: 999px;
        padding: 0.48rem 0.9rem;
        background: #fff;
        color: #39373d;
        font-weight: 600;
        cursor: pointer;
        transition: border-color 150ms ease, background 150ms ease, color 150ms ease, opacity 150ms ease;
    }

    .ghost-button:disabled,
    .composer button:disabled {
        opacity: 0.55;
        cursor: not-allowed;
        transform: none;
    }

    .composer button {
        min-width: 88px;
    }

    .ghost-button:hover:not(:disabled),
    .composer button:hover:not(:disabled) {
        border-color: #c8baf4;
        background: #f4f0ff;
        color: #49358c;
    }

    .ghost-button:focus-visible,
    .composer button:focus-visible {
        outline: 2px solid #8065d4;
        outline-offset: 2px;
    }

    .messages {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 0.85rem;
        min-height: 260px;
        padding: 1.1rem;
        overflow: auto;
        background: #fff;
    }

    .message {
        max-width: 80%;
        padding: 0.9rem 1rem;
        border: 1px solid #efeeed;
        border-radius: 1rem;
        line-height: 1.5;
        font-size: 0.95rem;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
        box-shadow: 0 2px 8px rgba(31, 29, 35, 0.035);
    }

    .message.incoming {
        align-self: flex-start;
        background: #f3f2f1;
        color: #343238;
        border-top-left-radius: 0.35rem;
    }

    .message.outgoing {
        align-self: flex-end;
        background: #eee9fc;
        border-color: #e4dcfa;
        color: #432f84;
        color: #000;
        border-top-right-radius: 0.35rem;
    }

    .composer {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.9rem 1.25rem 1.25rem;
        border-top: 1px solid #efeeed;
        background: #fff;
    }

    .composer-actions {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-shrink: 0;
    }

    .composer input {
        flex: 1 1 auto;
        min-width: 0;
        border: 1px solid #e6e5e3;
        border-radius: 0.85rem;
        background: #fff;
        padding: 0.85rem 1rem;
        font-size: 0.95rem;
        color: var(--dashboard-ink);
    }

    .composer input::placeholder {
        color: #a09ea3;
    }

    .composer input:focus {
        outline: 3px solid rgba(115, 86, 216, 0.12);
        border-color: #9a84e5;
    }

    .preview-panel {
        min-height: 0;
    }

    .frame-wrap {
        flex: 1;
        min-height: 0;
        padding: 0.85rem;
    }

    iframe {
        width: 100%;
        height: 100%;
        min-height: clamp(320px, calc(100vh - 18rem), 560px);
        border: 1px solid #ebeae8;
        border-radius: 0.9rem;
        background: #f8f8f7;
    }

    @@media (max-width: 900px) {
        .home-page {
            grid-template-columns: 1fr;
            gap: 0.85rem;
            padding: 0.85rem;
        }

        .frame-wrap {
            padding: 0.75rem;
        }

        .preview-panel {
            min-height: 420px;
        }
    }

    @@media (max-width: 560px) {
        .composer {
            align-items: stretch;
            flex-direction: column;
        }

        .composer-actions {
            justify-content: flex-end;
        }

        .panel-header {
            align-items: flex-start;
            padding: 1rem;
        }

        .panel-actions {
            gap: 0.35rem;
        }

        .panel-actions .ghost-button {
            padding: 0.55rem 0.7rem;
        }

        .preview-panel {
            min-height: 360px;
        }

        iframe {
            min-height: 320px;
        }
    }
</style>

<div class="home-page">
    <aside class="chat-panel">
        <div class="panel-header">
            <div>
                <p class="eyebrow">对话</p>
                <h2>项目助手</h2>
            </div>
            <div class="panel-actions">
                <button class="ghost-button" type="button" @onclick="ResetConversation">新建对话</button>
            </div>
        </div>

        <div class="messages" aria-live="polite">
            @foreach (var message in Messages)
            {
                <div class="message @(message.IsUser ? "outgoing" : "incoming")">
                    <span>@message.Content</span>
                </div>
            }

        </div>

        <EditForm Model="this" OnValidSubmit="SendMessageAsync" class="composer">
            <InputText @bind-Value="CurrentInput" placeholder="输入消息..." aria-label="输入消息" />
            <div class="composer-actions">
                <button type="submit" disabled="@IsLoading">发送</button>
                <button type="button" class="ghost-button" disabled="@(!IsLoading)" @onclick="CancelCurrentRun">取消</button>
            </div>
        </EditForm>
    </aside>

    <section class="preview-panel">
        <div class="panel-header">
            <div>
                <p class="eyebrow">预览</p>
                <h2>网页预览</h2>
            </div>
            <div class="panel-actions">
                <button
                    class="ghost-button"
                    type="button"
                    disabled="@string.IsNullOrWhiteSpace(GeneratedHtml)"
                    @onclick="DownloadPreviewAsync">
                    下载
                </button>
                <button
                    class="ghost-button"
                    type="button"
                    disabled="@(!IsLoggedIn || string.IsNullOrWhiteSpace(GeneratedHtml))"
                    @onclick="SavePreviewAsync">
                    保存
                </button>
            </div>
        </div>

        <div class="frame-wrap">
            @if (!string.IsNullOrWhiteSpace(GeneratedHtml))
            {
                <iframe
                    title="网页预览"
                    srcdoc="@PreparePreviewHtml(GeneratedHtml)"
                    sandbox="allow-scripts allow-modals allow-forms"
                    allow=""
                    referrerpolicy="no-referrer"
                    loading="lazy">
                </iframe>
            }
            else
            {
                <iframe
                    title="网页预览"
                    src="/html-host/index.html"
                    sandbox=""
                    loading="lazy">
                </iframe>
            }
        </div>
    </section>
</div>

@code {
    [SupplyParameterFromQuery(Name = "page")]
    public string? SavedPageId { get; set; }

    [SupplyParameterFromQuery(Name = "sessionid")]
    public string? SessionIdFromQuery { get; set; }

    [SupplyParameterFromQuery(Name = "prompt")]
    public string? PromptFromQuery { get; set; }

    private readonly List<ChatBubble> Messages = new();
    private string CurrentInput { get; set; } = string.Empty;
    private string? _pendingPrompt;
    private bool IsLoading { get; set; }
    private bool IsLoggedIn { get; set; }
    private string? CurrentUserId { get; set; }
    private string? GeneratedHtml { get; set; }
    private string? CurrentSessionId { get; set; }
    private bool _sessionIdWasProvided;
    private CancellationTokenSource? _runCts;
    private bool _disposed;

    private static string PreparePreviewHtml(string? html)
    {
        if (string.IsNullOrWhiteSpace(html))
        {
            return string.Empty;
        }

        const string previewBootstrap =
            "<meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src data: blob:; font-src data:; media-src data: blob:; connect-src 'none'; form-action 'none'; object-src 'none'; base-uri 'none'\">" +
            "<script>(()=>{const createStorage=()=>{const values=new Map();return{get length(){return values.size},key(index){return Array.from(values.keys())[index]??null},getItem(key){key=String(key);return values.has(key)?values.get(key):null},setItem(key,value){values.set(String(key),String(value))},removeItem(key){values.delete(String(key))},clear(){values.clear()}}};Object.defineProperty(window,'localStorage',{configurable:true,value:createStorage()});Object.defineProperty(window,'sessionStorage',{configurable:true,value:createStorage()});document.addEventListener('click',event=>{const link=event.target.closest?.('a[href]');if(link)event.preventDefault()},true)})();</script>";

        var headStart = html.IndexOf("<head", StringComparison.OrdinalIgnoreCase);
        if (headStart >= 0)
        {
            var headEnd = html.IndexOf('>', headStart);
            if (headEnd >= 0)
            {
                return html.Insert(headEnd + 1, previewBootstrap);
            }
        }

        var htmlStart = html.IndexOf("<html", StringComparison.OrdinalIgnoreCase);
        if (htmlStart >= 0)
        {
            var htmlEnd = html.IndexOf('>', htmlStart);
            if (htmlEnd >= 0)
            {
                return html.Insert(htmlEnd + 1, $"<head>{previewBootstrap}</head>");
            }
        }

        return previewBootstrap + html;
    }

    protected override async Task OnInitializedAsync()
    {
        AuthenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        _pendingPrompt = PromptFromQuery;
        _sessionIdWasProvided = !string.IsNullOrWhiteSpace(SessionIdFromQuery);
        CurrentSessionId = SessionIdFromQuery;
        if (!_sessionIdWasProvided)
        {
            UpdateSessionId(Guid.NewGuid().ToString("N"));
        }

        await LoadPageOrUserStateAsync(await AuthenticationStateProvider.GetAuthenticationStateAsync());
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || string.IsNullOrWhiteSpace(_pendingPrompt))
        {
            return;
        }

        var prompt = _pendingPrompt;
        _pendingPrompt = null;
        Navigation.NavigateTo(
            Navigation.GetUriWithQueryParameter("prompt", (string?)null),
            replace: true);
        CurrentInput = prompt;
        await SendMessageAsync();
    }

    private void OnAuthenticationStateChanged(Task<AuthenticationState> authenticationStateTask)
    {
        if (_disposed)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            try
            {
                await LoadPageOrUserStateAsync(await authenticationStateTask);
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Unable to load user state after an authentication change.");
            }
        });
    }

    private Task LoadPageOrUserStateAsync(AuthenticationState authState)
    {
        return string.IsNullOrWhiteSpace(SavedPageId)
            ? LoadUserStateAsync(authState)
            : LoadSavedPageAsync(authState);
    }

    private async Task LoadSavedPageAsync(AuthenticationState authState)
    {
        IsLoggedIn = authState.User.Identity?.IsAuthenticated == true;
        CurrentUserId = IsLoggedIn
            ? authState.User.FindFirst("oid")?.Value
                ?? authState.User.FindFirst("sub")?.Value
                ?? authState.User.Identity?.Name
            : null;

        Messages.Clear();
        GeneratedHtml = null;

        if (!IsLoggedIn || string.IsNullOrWhiteSpace(CurrentUserId))
        {
            return;
        }

        GeneratedHtml = await UserStateService.LoadSavedPageAsync(CurrentUserId, SavedPageId!);
    }

    private async Task LoadUserStateAsync(AuthenticationState authState)
    {
        IsLoggedIn = authState.User.Identity?.IsAuthenticated == true;
        CurrentUserId = IsLoggedIn
            ? authState.User.FindFirst("oid")?.Value
                ?? authState.User.FindFirst("sub")?.Value
                ?? authState.User.Identity?.Name
            : null;

        if (!IsLoggedIn || string.IsNullOrWhiteSpace(CurrentUserId))
        {
            Messages.Clear();
            Messages.Add(new ChatBubble("你好！我可以帮你创建网页应用。", false));
            GeneratedHtml = null;

            return;
        }

        if (string.IsNullOrWhiteSpace(CurrentSessionId))
        {
            return;
        }

        var userState = await UserStateService.LoadAsync(CurrentUserId, CurrentSessionId);
        if (_sessionIdWasProvided && userState.SessionLookupSucceeded && userState.SessionExists)
        {
            Messages.Clear();
            if (!await RestoreChatHistoryAsync(userState.ChatMessages, userState.GeneratedHtml))
            {
                Messages.Add(new ChatBubble("你好！我可以帮你创建网页应用。", false));
            }

            GeneratedHtml = userState.GeneratedHtml;
        }
        else{
            if (Messages.Count == 0)
            {
                Messages.Add(new ChatBubble("你好！我可以帮你创建网页应用。", false));
            }
        }
    }

    private async Task<bool> RestoreChatHistoryAsync(
        IReadOnlyList<UserChatMessage>? storedMessages,
        string? generatedHtml)
    {
        if (storedMessages is null || storedMessages.Count == 0)
        {
            return false;
        }

        try
        {
            var agentMessages = storedMessages.Select(message =>
                new ChatMessage(
                    string.Equals(message.Role, "user", StringComparison.OrdinalIgnoreCase) ? ChatRole.User : ChatRole.Assistant,
                    message.Content)).ToList();

            if (!string.IsNullOrWhiteSpace(generatedHtml))
            {
                agentMessages.Add(new ChatMessage(ChatRole.Assistant, generatedHtml));
            }

            await ChatAgentHandler.RestoreHistoryAsync(agentMessages);
            Messages.AddRange(storedMessages.Select(message =>
                new ChatBubble(message.Content, string.Equals(message.Role, "user", StringComparison.OrdinalIgnoreCase))));
            return true;
        }
        catch (System.Text.Json.JsonException ex)
        {
            Logger.LogError(ex, "Stored chat history is not valid JSON.");
            return false;
        }
    }

    public void Dispose()
    {
        _disposed = true;
        AuthenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }

    private async Task SendMessageAsync()
    {
        var trimmed = CurrentInput.Trim();
        if (string.IsNullOrWhiteSpace(trimmed))
        {
            return;
        }

        Messages.Add(new ChatBubble(trimmed, true));        

        CurrentInput = string.Empty;
        IsLoading = true;
        var previousHtml = GeneratedHtml;
        await SaveChatHistoryAsync();

        _runCts = new CancellationTokenSource();
        var assistantMessage = new ChatBubble("正在思考...", false);
        Messages.Add(assistantMessage);
        await InvokeAsync(StateHasChanged);

        try
        {
            var reply = await ChatAgentHandler.SendAsync(
                trimmed,
                _runCts.Token,
                async streamedText =>
                {
                    assistantMessage.Content = streamedText + "\r\n  正在思考...";
                    await InvokeAsync(StateHasChanged);
                });
            if (!string.IsNullOrWhiteSpace(ChatAgentHandler.LastHtmlContent))
            {
                GeneratedHtml = ChatAgentHandler.LastHtmlContent;
            }
            assistantMessage.Content = reply;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
            assistantMessage.Content = "请求已取消。";
        }
        catch (Exception ex)
        {
            assistantMessage.Content = $"请求失败：{ex.Message}";
            Logger.LogError(ex, "Error during chat agent processing.");
        }
        finally
        {
            _runCts?.Dispose();
            _runCts = null;
            IsLoading = false;
            await SaveChatHistoryAsync();
            if (!string.Equals(previousHtml, GeneratedHtml, StringComparison.Ordinal))
            {
                await SaveGeneratedHtmlAsync();
            }
        }
    }

    private void CancelCurrentRun()
    {
        if (IsLoading)
        {
            _runCts?.Cancel();
        }
    }

    private async Task DownloadPreviewAsync()
    {
        if (string.IsNullOrWhiteSpace(GeneratedHtml))
        {
            return;
        }

        await JS.InvokeVoidAsync("downloadHtmlFile", "生成的网页.html", GeneratedHtml);
    }

    private async Task SavePreviewAsync()
    {
        if (!IsLoggedIn || string.IsNullOrWhiteSpace(GeneratedHtml) || string.IsNullOrWhiteSpace(CurrentUserId))
        {
            return;
        }

        var requestedName = await JS.InvokeAsync<string>("prompt", "请输入此网页的文件名：", "网页");
        if (string.IsNullOrWhiteSpace(requestedName))
        {
            return;
        }

        var fileName = requestedName.Trim();
        var safeFileName = new string(fileName.Select(ch => Path.GetInvalidFileNameChars().Contains(ch) ? '_' : ch).ToArray());
        if (string.IsNullOrWhiteSpace(Path.GetFileNameWithoutExtension(safeFileName)))
        {
            safeFileName = "网页.html";
        }
        else if (!safeFileName.EndsWith(".html", StringComparison.OrdinalIgnoreCase))
        {
            safeFileName += ".html";
        }

        try
        {
            await UserStateService.SavePageAsync(CurrentUserId, safeFileName, GeneratedHtml);
        }
        catch (Exception ex)
        {
            Messages.Add(new ChatBubble($"无法保存网页：{ex.Message}", false));
        }
    }

    private async Task ResetConversation()
    {
        try
        {
            await ChatAgentHandler.NewSessionAsync();
        }
        catch (Exception ex)
        {
            Messages.Add(new ChatBubble($"无法创建新对话：{ex.Message}", false));
            return;
        }

        var previousHtml = GeneratedHtml;
        Messages.Clear();
        GeneratedHtml = null;
        CurrentInput = string.Empty;
        UpdateSessionId(Guid.NewGuid().ToString("N"));
        Messages.Add(new ChatBubble("已开始新对话。你可以继续描述项目或应用需求。", false));
    }

    private async Task SaveChatHistoryAsync()
    {
        if (!IsLoggedIn || string.IsNullOrWhiteSpace(CurrentUserId) || string.IsNullOrWhiteSpace(CurrentSessionId))
        {
            return;
        }

        await UserStateService.SaveChatHistoryAsync(
            CurrentUserId,
            CurrentSessionId,
            Messages.Select(message => new UserChatMessage(
                message.IsUser ? "user" : "assistant",
                message.Content)));
    }

    private async Task SaveGeneratedHtmlAsync()
    {
        if (!IsLoggedIn || string.IsNullOrWhiteSpace(CurrentUserId) || string.IsNullOrWhiteSpace(CurrentSessionId))
        {
            return;
        }

        await UserStateService.SaveGeneratedHtmlAsync(CurrentUserId, CurrentSessionId, GeneratedHtml);
    }

    private void UpdateSessionId(string sessionId)
    {
        if (string.Equals(CurrentSessionId, sessionId, StringComparison.Ordinal))
        {
            return;
        }

        CurrentSessionId = sessionId;
        Navigation.NavigateTo(
            Navigation.GetUriWithQueryParameter("sessionid", sessionId),
            replace: true);
    }

    private sealed class ChatBubble
    {
        public ChatBubble(string content, bool isUser)
        {
            Content = content;
            IsUser = isUser;
        }

        public string Content { get; set; }
        public bool IsUser { get; }
    }
    
}
